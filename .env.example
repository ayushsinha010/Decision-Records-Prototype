# Example environment variables for watcher.py.
#
# NOTE: watcher.py does not load .env files by itself. Export these in your
# shell (or load this file with your own tooling) before running it.
# Never commit real keys.

# Required: your Anthropic API key (read by the anthropic SDK).
ANTHROPIC_API_KEY=your-api-key-here

# Optional: override the Claude model used for extraction (default: claude-sonnet-5).
# DECISION_RECORDS_MODEL=claude-sonnet-5
